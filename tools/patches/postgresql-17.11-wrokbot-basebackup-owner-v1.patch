+   x->file=openat(parent,leaf,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);
+   if(x->file<0)wrok_fail(11);
+   x->remaining=size;x->allocated=0;
+  }
+  close(parent);
+ } else if(context==BBSTREAMER_MEMBER_CONTENTS) {
+  if(!m||m->is_directory||x->file<0||((uint64)len)>x->remaining)wrok_fail(7);
+  while(len) {
+   size_t n=(uint64)len>lim[L_BLOCK]?(size_t)lim[L_BLOCK]:(size_t)len;
+   if(!wrok_check())wrok_fail(failure);
+   check_space();
+   if(!write_exact(x->file,(const unsigned char *)data,n,false))wrok_fail(11);
+   data+=n;len-=n;x->remaining-=n;
+  }
+ } else if(context==BBSTREAMER_MEMBER_TRAILER) {
+  if(x->file>=0) {
+   if(x->remaining||fsync(x->file)||close(x->file))wrok_fail(11);
+   x->file=-1;
+  }
+ } else if(context==BBSTREAMER_ARCHIVE_TRAILER) {
+  if(x->file>=0)wrok_fail(7);
+ } else wrok_fail(7);
+}
+static void extract_finalize(bbstreamer *s) {
+ WrokExtractor *x=(WrokExtractor *)s;
+ if(x->file>=0||fsync(x->rootfd))wrok_fail(11);
+}
+static void extract_free(bbstreamer *s) {
+ WrokExtractor *x=(WrokExtractor *)s;
+ if(x->file>=0)wrok_fail(11);
+ close(x->rootfd);pfree(x);
+}
+static const bbstreamer_ops extractor_ops={
+ .content=extract_content,.finalize=extract_finalize,.free=extract_free
+};
+bbstreamer *
+wrok_extractor_new(const char *root)
+{
+ WrokExtractor *x=palloc0(sizeof(*x));
+ struct stat st,held;
+ x->base.bbs_ops=&extractor_ops;x->file=-1;
+ x->rootfd=open(root,O_RDONLY|O_DIRECTORY|O_NOFOLLOW);
+ if(x->rootfd<0||fstat(x->rootfd,&st)||st.st_uid!=geteuid()||
+    (st.st_mode&0777)!=0700||strcmp(root,output_root)||output_fd<0||fstat(output_fd,&held)||
+    st.st_dev!=held.st_dev||st.st_ino!=held.st_ino)wrok_fail(11);
+ return &x->base;
+}
+static void
+count_tree(int dir,unsigned int depth,const char *prefix)
+{
+ DIR *stream;struct dirent *entry;
+ if(depth>lim[L_DEPTH])wrok_fail(7);
+ stream=fdopendir(dup(dir));if(!stream)wrok_fail(11);
+ while((entry=readdir(stream))) {
+  struct stat st;char path[MAXPGPATH];int fd;
+  if(!strcmp(entry->d_name,".")||!strcmp(entry->d_name,".."))continue;
+  if(!wrok_check())wrok_fail(failure);
+  if(snprintf(path,sizeof(path),"%s%s%s",prefix,*prefix?"/":"",entry->d_name)>=(int)sizeof(path))
+   wrok_fail(7);
+  if(strlen(path)>lim[L_PATH]||fstatat(dir,entry->d_name,&st,AT_SYMLINK_NOFOLLOW))wrok_fail(11);
+  if(S_ISDIR(st.st_mode)) {
+   directories=uadd(directories,1);if(directories>lim[L_DIRS])wrok_fail(7);
+   fd=openat(dir,entry->d_name,O_RDONLY|O_DIRECTORY|O_NOFOLLOW);if(fd<0)wrok_fail(11);
+   count_tree(fd,depth+1,path);if(fsync(fd)||close(fd))wrok_fail(11);
+  } else if(S_ISREG(st.st_mode)&&st.st_nlink==1&&st.st_size>=0) {
+   uint64 n=(uint64)st.st_size;
+   total_files=uadd(total_files,1);total_bytes=uadd(total_bytes,n);
+   io_blocks=uadd(io_blocks,blocks_for(n));
+   if(n>lim[L_SINGLE]||total_files>lim[L_FILES]||total_bytes>lim[L_PLAIN]||
+      total_bytes>lim[L_SPOOL]||io_blocks>lim[L_BLOCKS])wrok_fail(7);
+   if(!strncmp(path,"pg_wal/",7)&&strlen(path+7)==24) {
+    wal_files=uadd(wal_files,1);wal_bytes=uadd(wal_bytes,n);
+    if(wal_files>lim[L_WALSEGS]||wal_bytes>lim[L_WAL])wrok_fail(7);
+   }
+   if(!strcmp(path,"backup_manifest") && (n==0||n>lim[L_MANIFEST]))wrok_fail(7);
+   fd=openat(dir,entry->d_name,O_RDONLY|O_NOFOLLOW);
+   if(fd<0||fsync(fd)||close(fd))wrok_fail(11);
+  } else wrok_fail(7);
+ }
+ closedir(stream);
+}
+static void
+verify_output(void)
+{
+ int fd=open(output_root,O_RDONLY|O_DIRECTORY|O_NOFOLLOW);
+ struct stat m;
+ if(fd<0)wrok_fail(11);
+ total_files=total_bytes=wal_files=wal_bytes=directories=io_blocks=0;
+ count_tree(fd,0,"");
+ if(!wal_files||!wal_bytes||fstatat(fd,"backup_manifest",&m,AT_SYMLINK_NOFOLLOW)||
+    !S_ISREG(m.st_mode)||!m.st_size||fsync(fd))wrok_fail(7);
+ close(fd);
+}
+
+static uint64
+allocated_tree(int dir,unsigned int depth)
+{
+ DIR *d;struct dirent *e;uint64 total=0;
+ if(depth>lim[L_DEPTH]||depth>64)wrok_fail(7);
+ d=fdopendir(dup(dir));if(!d)wrok_fail(11);
+ while((e=readdir(d))) {
+  struct stat m;
+  if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;
+  if(!wrok_check())wrok_fail(failure);
+  if(++allocation_nodes>uadd(lim[L_FILES],lim[L_DIRS])||
+     fstatat(dir,e->d_name,&m,AT_SYMLINK_NOFOLLOW))wrok_fail(7);
+  if(S_ISDIR(m.st_mode)) {
+   int fd=openat(dir,e->d_name,O_RDONLY|O_DIRECTORY|O_NOFOLLOW);
+   if(fd<0)wrok_fail(11);
+   total=uadd(total,allocated_tree(fd,depth+1));close(fd);
+  } else if(!S_ISREG(m.st_mode)||m.st_nlink!=1)wrok_fail(7);
+  if(m.st_blocks<0)wrok_fail(7);
+  total=uadd(total,umul((uint64)m.st_blocks,512));
+ }
+ closedir(d);return total;
+}
+FILE *
+wrok_manifest_open(void)
+{
+ int root=open(output_root,O_RDONLY|O_DIRECTORY|O_NOFOLLOW),fd;FILE *out;
+ if(root<0)wrok_fail(11);
+ check_space();
+ fd=openat(root,"backup_manifest.tmp",O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);
+ close(root);if(fd<0)wrok_fail(11);
+ out=fdopen(fd,"wb");if(!out){close(fd);wrok_fail(11);}return out;
+}
