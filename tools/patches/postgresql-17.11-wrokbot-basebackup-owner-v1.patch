+/*
+ * Distinct PG17.11 WrokBot maintenance helper. Never linked into the v1 bundle.
+ * No password option/environment/passfile/prompt. No monitor thread before fork.
+ */
+#include "postgres_fe.h"
+#define WROKBOT_OWNER_IMPLEMENTATION
+#include "wrokbot_owner.h"
+#include "libpq-int.h"
+#include "common/fe_memutils.h"
+#include <dirent.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/wait.h>
+#include <time.h>
