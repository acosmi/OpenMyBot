+enum {
+ L_T0,L_E,L_C,L_SECRET,L_SECMEM,L_SECCOPIES,L_CONTROL,L_STATUS,L_RECORDS,
+ L_STDERR,L_FILES,L_DIRS,L_PATH,L_DEPTH,L_SINGLE,L_PLAIN,L_WAL,L_WALSEGS,
+ L_WALSPAN,L_WALTL,L_MANIFEST,L_BLOCKS,L_BLOCK,L_SPOOL,L_RESTORE,L_FDS,
+ L_JOURNAL,L_RESERVE,L_FREE,L_COUNT
+};
+static const char *limit_names[L_COUNT] = {
+ "t0-ns","effect-deadline-ns","convergence-deadline-ns","max-source-secret-bytes",
+ "max-secret-memory-bytes","max-native-secret-copies","max-control-bytes",
+ "max-status-bytes","max-status-records","max-stderr-bytes","max-material-files",
+ "max-directories","max-path-bytes","max-depth","max-single-file-bytes",
+ "max-material-plain-bytes","max-wal-bytes","max-wal-segments","max-wal-span-bytes",
+ "max-wal-timelines","max-backup-manifest-bytes","max-total-copy-blocks",
+ "copy-block-bytes","max-spool-bytes","max-restore-check-bytes","max-open-files",
+ "max-journal-bytes","capacity-reserve-bytes","free-floor-bytes"
+};
+static uint64 lim[L_COUNT], control_bytes, status_bytes, diagnostic_bytes;
+static uint32 status_seq;
+static unsigned char operation[16], secret[4097], cancel_frame[49];
+static size_t secret_len, cancel_used;
+static unsigned int failure;
+static bool initialized, worker, terminal_success, waiting_worker, finalized;
+static pid_t original_worker = -1;
+static int worker_status, root_parent = -1, output_fd = -1;
+static int prebuilt_fds[3]={-1,-1,-1};
+static const char *prebuilt_names[3]={"pg_wal","pg_wal/archive_status","pg_wal/summaries"};
+static void close_prebuilt(void);
+static bool worker_waited;
+static uint64 system_id, start_lsn, stop_lsn, total_bytes, total_files;
+static uint64 wal_bytes, wal_files, directories, io_blocks, manifest_bytes, wal_reserved;
+static uint64 allocated_cache, space_checked_ns, allocation_nodes;
+static uint64 allocated_tree(int, unsigned int);
+static uint32 timeline, segment_bytes;
+static char *output_root;
+static PGconn *connections[2];
+static uint64 wait_observed_ns;
+static void verify_output(void);
+
+static uint64
+uadd(uint64 a, uint64 b)
+{
+ if (UINT64_MAX-a < b) wrok_fail(7);
+ return a+b;
+}
+static uint64
+umul(uint64 a, uint64 b)
+{
+ if (a && b > UINT64_MAX/a) wrok_fail(7);
+ return a*b;
+}
+static uint64
+blocks_for(uint64 n)
+{
+ if(!lim[L_BLOCK])wrok_fail(7);
+ return n/lim[L_BLOCK]+(n%lim[L_BLOCK]!=0);
+}
+static bool
+valid_utf8(const unsigned char *s,size_t n)
+{
+ size_t i=0;
+ while(i<n) {
+  unsigned int c=s[i++],need,min=0;
+  uint32 cp;
+  if(c<0x80){if(!c)return false;continue;}
+  if(c>=0xC2&&c<=0xDF){need=1;cp=c&0x1F;min=0x80;}
+  else if(c>=0xE0&&c<=0xEF){need=2;cp=c&0x0F;min=0x800;}
+  else if(c>=0xF0&&c<=0xF4){need=3;cp=c&7;min=0x10000;}
+  else return false;
+  if(n-i<need)return false;
+  while(need--){c=s[i++];if((c&0xC0)!=0x80)return false;cp=(cp<<6)|(c&0x3F);}
+  if(cp<min||cp>0x10FFFF||(cp>=0xD800&&cp<=0xDFFF))return false;
+ }
+ return true;
+}
+static uint64
+now_ns(void)
+{
+ struct timespec t;
+ if (clock_gettime(CLOCK_MONOTONIC,&t) || t.tv_sec < 0 || t.tv_nsec < 0 ||
+     t.tv_nsec >= 1000000000L || (uint64)t.tv_sec > UINT64_MAX/1000000000ULL) {
+  if(finalized){failure=4;return 0;}wrok_fail(4);
+ }
+ return uadd((uint64)t.tv_sec*1000000000ULL,(uint64)t.tv_nsec);
+}
+static uint64
+decimal(const char *s)
+{
+ uint64 v=0;
+ if (!s || !*s || (s[0]=='0' && s[1])) wrok_fail(1);
+ for (;*s;s++) {
+  if (*s<'0' || *s>'9' || v>(UINT64_MAX-(*s-'0'))/10) wrok_fail(1);
+  v=v*10+(*s-'0');
+ }
+ if (!v) wrok_fail(1);
+ return v;
+}
+static uint64
+get_be(const unsigned char *p, unsigned int n)
+{
+ uint64 v=0;
+ while (n--) v=(v<<8)|*p++;
+ return v;
+}
+static void
+put_be(unsigned char *p, unsigned int n, uint64 v)
+{
+ while (n) { p[--n]=v&255; v>>=8; }
+}
+static void
+wipe_secret(void)
+{
+ explicit_bzero(secret,sizeof(secret)); secret_len=0;
+}
+bool wrok_is_worker(void) { return worker; }
+
+static void
+read_control(void)
+{
+ ssize_t n;
+ if (worker || !initialized || failure) return;
+ for (;;) {
+  n=read(STDIN_FILENO,cancel_frame+cancel_used,sizeof(cancel_frame)-cancel_used);
+  if (n<0 && (errno==EAGAIN || errno==EWOULDBLOCK)) return;
+  if (n<0 && errno==EINTR) continue;
+  if (n<=0) { failure=6; return; }
+  control_bytes=uadd(control_bytes,(uint64)n);
+  cancel_used+=n;
+  if (control_bytes>lim[L_CONTROL] || cancel_used>48) { failure=3; return; }
+  if (cancel_used>=40) {
+   if (memcmp(cancel_frame,"WRKPGM01",8) || get_be(cancel_frame+8,2)!=1 ||
+       get_be(cancel_frame+10,2)!=3 || get_be(cancel_frame+12,2)!=40 ||
+       get_be(cancel_frame+14,2)!=0 || memcmp(cancel_frame+16,operation,16) ||
+       get_be(cancel_frame+32,4)!=2 || get_be(cancel_frame+36,4)!=8) {
+    failure=3; return;
+   }
+  }
+  if (cancel_used==48) {
+   uint64 c=get_be(cancel_frame+40,8);
+   if (c==0 || c>lim[L_C]) { failure=3; return; }
+   lim[L_C]=c; failure=now_ns()>=c?12:6; return;
+  }
+ }
+}
+bool
+wrok_check(void)
+{
+ if (initialized) {
+  read_control();
+  if (!failure && now_ns()>=lim[L_E]) failure=5;
+ }
+ return failure==0;
+}
+static int
+wait_fd(int fd, short events, int stop, long maximum_ms, bool closing)
+{
+ for (;;) {
+  struct pollfd p[3]; int count=0, which=-1, r;
+  uint64 now=now_ns(), end=closing ? lim[L_C] : lim[L_E], remaining;
+  long timeout;
+  if (!closing && !wrok_check()) return -1;
+  if (now>=end) { if (!failure) failure=5; return -1; }
+  remaining=(end-now+999999ULL)/1000000ULL;
+  timeout=remaining>100 ? 100 : (long)remaining;
+  if (maximum_ms>=0 && timeout>maximum_ms) timeout=maximum_ms;
+  if (fd>=0) { which=count; p[count++]=(struct pollfd){fd,events,0}; }
+  if (!worker) p[count++]=(struct pollfd){STDIN_FILENO,POLLIN|POLLHUP,0};
+  if (stop>=0) p[count++]=(struct pollfd){stop,POLLIN|POLLHUP,0};
+  r=poll(p,count,(int)timeout);
+  if (r<0 && errno==EINTR) continue;
+  if (r<0) { if (!failure) failure=11; return -1; }
+  if (!worker) read_control();
+  if (!closing && failure) return -1;
+  if (which>=0 && p[which].revents&(events|POLLERR|POLLHUP)) return 1;
+  if (stop>=0 && p[count-1].revents) return 0;
+  if (maximum_ms>=0) return 0;
+ }
+}
+int
+wrok_poll_pg(PGconn *c, bool writing, int stop, long timeout)
+{
+ return wait_fd(PQsocket(c),writing ? POLLOUT : POLLIN,stop,timeout,false);
+}
+static bool
+write_exact(int fd,const unsigned char *p,size_t n,bool closing)
+{
+ while (n) {
+  ssize_t r=write(fd,p,n);
+  if (r<0 && errno==EINTR) continue;
+  if (r<0 && (errno==EAGAIN || errno==EWOULDBLOCK)) {
+   if (wait_fd(fd,POLLOUT,-1,-1,closing)<0) return false;
+   continue;
+  }
+  if (r<=0) { if (!failure) failure=3; return false; }
+  p+=r;n-=r;
+ }
+ return true;
+}
+static void
+read_exact(unsigned char *p,size_t n)
+{
+ while (n) {
+  ssize_t r=read(STDIN_FILENO,p,n);
+  if (r<0 && errno==EINTR) continue;
+  if (r<0 && (errno==EAGAIN || errno==EWOULDBLOCK)) {
+   if (wait_fd(STDIN_FILENO,POLLIN,-1,-1,false)<0) wrok_fail(failure ? failure:3);
+   continue;
+  }
+  if (r<=0) wrok_fail(3);
+  p+=r;n-=r;control_bytes=uadd(control_bytes,(uint64)r);
+  if (control_bytes>lim[L_CONTROL]) wrok_fail(3);
+ }
+}
+static void
+read_frame(unsigned int kind,unsigned int seq,unsigned char *data,size_t *n)
+{
+ unsigned char h[40]; uint64 size;
+ read_exact(h,40);
+ if (memcmp(h,"WRKPGM01",8) || get_be(h+8,2)!=1 || get_be(h+10,2)!=kind ||
+     get_be(h+12,2)!=40 || get_be(h+14,2) || memcmp(h+16,operation,16) ||
+     get_be(h+32,4)!=seq) wrok_fail(3);
+ size=get_be(h+36,4);
+ if (size>*n) wrok_fail(3);
+ *n=(size_t)size;
+ if (size) read_exact(data,(size_t)size);
+}
+static void
+status(unsigned int event)
+{
+ unsigned char record[168]={0}; unsigned char *b=record+40;
+ uint64 flags=(original_worker>0 ? 1:0)|(worker_waited ? 2:0)|
+              (!connections[0] && !connections[1] ? 4:0)|
+              (!secret_len ? 8:0)|(event==8 ? 16:0);
+ if (worker || !initialized) return;
+ if (status_seq>=lim[L_RECORDS] || uadd(status_bytes,sizeof(record))>lim[L_STATUS]) {
+  if (!failure) failure=3; return;
+ }
+ memcpy(record,"WRKPGM01",8);put_be(record+8,2,1);put_be(record+10,2,0x8001);
+ put_be(record+12,2,40);memcpy(record+16,operation,16);
+ put_be(record+32,4,status_seq++);put_be(record+36,4,128);
+ put_be(b,2,event);put_be(b+2,2,failure);put_be(b+4,4,getpid());
+ put_be(b+8,4,original_worker>0 ? original_worker:0);put_be(b+12,4,(uint32)worker_status);
+ put_be(b+16,8,system_id);put_be(b+24,4,timeline);put_be(b+28,4,segment_bytes);
+ put_be(b+32,8,start_lsn);put_be(b+40,8,stop_lsn);
+ put_be(b+48,8,total_bytes);put_be(b+56,8,total_files);
+ put_be(b+64,8,wal_bytes);put_be(b+72,8,wal_files);
+ put_be(b+80,8,now_ns());put_be(b+88,8,wait_observed_ns);put_be(b+96,8,flags);
+ status_bytes+=sizeof(record);
+ (void)write_exact(STDOUT_FILENO,record,sizeof(record),failure!=0 || event>=6);
+}
+void
+wrokbot_owner_redacted_log(int is_error)
+{
+ if(!is_error)return;
+ static const unsigned char code[]="wrokbot_pg_maintenance_failed\n";
+ if (!failure) failure=9;
+ if (initialized && diagnostic_bytes+sizeof(code)-1<=lim[L_STDERR]) {
+  diagnostic_bytes+=sizeof(code)-1;
+  (void)write_exact(STDERR_FILENO,code,sizeof(code)-1,true);
+ }
+}
+static void
+close_all(void)
